{
  "name": "pickory/product-filter",
  "authors": [
    {
      "name": "Pickory",
      "email": "support@pickory.com"
    }
  ],
  "require-dev": {
    "squizlabs/php_codesniffer": "3.13.4",
    "php-stubs/wordpress-stubs": "^7.0",
    "php-stubs/woocommerce-stubs": "^3.8",
    "wp-coding-standards/wpcs": "^3.2",
    "phpunit/phpunit": "^9.0",
    "brain/monkey": "^2.0",
    "yoast/phpunit-polyfills": "^1.0",
    "phpstan/phpstan": "^2.2",
    "phpstan/extension-installer": "^1.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "scripts": {
    "phpcompat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.1- --extensions=php includes/ templates/"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
